# cp .env.example .env and fill in the values.  .env is not committed.

# To write into the mounted ~/.kal, the container user needs the same uid as the host.
#   echo "UID=$(id -u)" >> .env && echo "GID=$(id -g)" >> .env
UID=1000
GID=1000

# A host path.  Compose's .env parser does not expand ~ (no shell is involved), so write it absolute.
KAL_DIR=/Users/you/.kal
VAULT_DIR=/Users/you/vault
# The vault name Obsidian knows.  Pressing a document path in the galaxy view builds an
# obsidian://open deep link with this name.  Usually the last folder of VAULT_DIR.
VAULT_NAME=vault
# Only its `projects/` subfolder (session transcripts, read by the distill step) is mounted, read-only.
CLAUDE_DIR=/Users/you/.claude

# The domain (only when using the proxy profile)
DOMAIN=kallimachos.local
# Only when attaching TLS.  It has to be a real public domain.
TLS_DOMAIN=
TLS_EMAIL=

# Ports (when connecting directly, without the proxy).
# ⚠ compose binds to 127.0.0.1 only —— because there is no authentication.
#   To open it externally, attach basic auth or forward-auth first.
WEB_PORT=5173
API_PORT=8080

# The host claude relay.  Put the value `just relay` prints in here.
# Without it the container's LLM steps are blocked with a 412 (there is no authentication).
KAL_CLAUDE_RELAY=http://host.docker.internal:8791
KAL_RELAY_TOKEN=

# Paths extraction must not send off the machine (claude -p).  Colon-separated.
#   For example: KAL_NO_LLM=Private:Finance
KAL_NO_LLM=

# Folders excluded from indexing and transmission (vault-relative, colon-separated).
# ⚠ This is **a transmission boundary** —— notes in a folder not listed here go off the
#   machine through `claude -p` during extraction.  To block a single document, put
#   `no_llm: true` in its frontmatter.  .git · .obsidian · node_modules · .omc and the like are excluded automatically.
KAL_SKIP=
